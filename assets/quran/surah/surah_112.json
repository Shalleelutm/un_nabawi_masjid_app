{
    "name":  "Al-Ikhlaas",
    "verse":  {
                  "verse_1":  "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ",
                  "verse_2":  "ٱللَّهُ ٱلصَّمَدُ",
                  "verse_3":  "لَمْ يَلِدْ وَلَمْ يُولَدْ",
                  "verse_4":  "وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ"
              }
}
